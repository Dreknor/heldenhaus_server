APP_NAME=Heldenhaus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://heldenhaus.example.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Kein Redis auf dem Webhosting: alles über die Datenbank
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mail.your-server.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="heldenhaus@example.de"
MAIL_FROM_NAME="${APP_NAME}"

# Beitritt nur per Einladungscode
HELDENHAUS_REGISTRATION_OPEN=false

# Online-Updater (docs/deployment.md, Abschnitt 6; weitere Optionen in config/updater.php)
UPDATER_ENABLED=true
#UPDATER_BRANCH=main
UPDATER_PHP_BINARY=php83
#UPDATER_COMPOSER_BINARY=/usr/home/xyz/composer.phar
#UPDATER_NPM_BINARY=/usr/home/xyz/.nvm/versions/node/v22.11.0/bin/npm
#UPDATER_MYSQLDUMP_BINARY=/usr/bin/mysqldump
UPDATER_BACKUP=true
UPDATER_BACKUP_REQUIRED=true

VITE_APP_NAME="${APP_NAME}"

# Push über Firebase Cloud Messaging (Dienstkonto-JSON), ohne Datei bleibt Push aus
# FCM_CREDENTIALS=/pfad/zu/firebase.json

# Optional: KI-Schrittvorschläge über OpenRouter (Eltern schalten sie pro Familie frei)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
